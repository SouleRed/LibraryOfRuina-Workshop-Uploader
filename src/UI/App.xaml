<Application x:Class="SteamworkUploader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SteamworkUploader;component/Localization/Strings.zh-CN.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Invitation palette translated from the approved HTML concept. -->
            <Color x:Key="WindowColor">#040405</Color>
            <Color x:Key="InvitationColor">#0D0E11</Color>
            <Color x:Key="CardColor">#E614151A</Color>
            <Color x:Key="RailColor">#F20E0F13</Color>
            <Color x:Key="InputColor">#08090B</Color>
            <Color x:Key="GoldColor">#D4AF37</Color>
            <Color x:Key="GoldLightColor">#F3E5AB</Color>
            <Color x:Key="GoldDarkColor">#6E5818</Color>
            <Color x:Key="TextColor">#DCDCDC</Color>
            <Color x:Key="TextGoldColor">#DFC26A</Color>
            <Color x:Key="TextMutedColor">#7C808A</Color>
            <Color x:Key="DangerColor">#D94B4B</Color>
            <Color x:Key="SuccessColor">#D4AF37</Color>

            <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="InvitationBrush" Color="{StaticResource InvitationColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
            <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
            <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}" />
            <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="TextGoldBrush" Color="{StaticResource TextGoldColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="#47D4AF37" />
            <SolidColorBrush x:Key="BorderBrightBrush" Color="#A6D4AF37" />
            <SolidColorBrush x:Key="GoldDimBrush" Color="#1FD4AF37" />
            <SolidColorBrush x:Key="ProgressLineInactiveBrush" Color="#1AFFFFFF" />

            <LinearGradientBrush x:Key="InvitationFrameBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#D4AF37" />
                <GradientStop Offset="0.34" Color="#4A3B0F" />
                <GradientStop Offset="0.68" Color="#8A7322" />
                <GradientStop Offset="1" Color="#D4AF37" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="RedButtonBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#7A0000" />
                <GradientStop Offset="1" Color="#3B0000" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="RedButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#990000" />
                <GradientStop Offset="1" Color="#520000" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GoldButtonBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#26D4AF37" />
                <GradientStop Offset="1" Color="#4D7A631C" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GoldRuleBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#70D4AF37" />
                <GradientStop Offset="1" Color="#00D4AF37" />
            </LinearGradientBrush>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Cinzel, Georgia, PingFang SC, SimSun" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            </Style>

            <Style x:Key="InvitationCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#000000" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardHeadingStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontStyle" Value="Italic" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RailHeadingStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SelectionBrush" Value="#66D4AF37" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                    <Setter TargetName="InputBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#D4AF37" Opacity="0.22" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="InputBorder" Property="Opacity" Value="0.48" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Keep every single-line information field on the same baseline and height. -->
            <Style x:Key="SingleLineTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="6,2" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="Background" Value="{StaticResource RedButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource RedButtonHoverBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GoldLightBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#D4AF37" Opacity="0.35" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.46" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="Background" Value="{StaticResource GoldButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="Foreground" Value="#050505" />
                                    <Setter TargetName="ButtonBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#D4AF37" Opacity="0.42" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModeButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="Background" Value="{StaticResource InputBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#14D4AF37" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelectedModeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="Background" Value="{StaticResource RedButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="RailOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="RailOptionSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource RailOptionButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#30D4AF37" />
                            <GradientStop Offset="1" Color="#00D4AF37" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}" />
                <Setter Property="BorderThickness" Value="3,1,1,1" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="Background" Value="#0DD4AF37" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CaptionBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CaptionBorder" Property="Background" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="Foreground" Value="#050505" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#8B0000" />
                        <Setter Property="BorderBrush" Value="#FF4D4D" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ProgressStepInactiveStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#33FFFFFF" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ProgressStepActiveStyle" TargetType="TextBlock" BasedOn="{StaticResource ProgressStepInactiveStyle}">
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#D4AF37" Opacity="0.8" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6" />
                <Setter Property="MinWidth" Value="6" />
                <Setter Property="MaxWidth" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="1">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder" Background="{StaticResource GoldDarkBrush}" CornerRadius="2" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource GoldBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
