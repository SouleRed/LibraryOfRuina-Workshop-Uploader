<Window x:Class="SteamworkUploader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource AppTitle}"
        Width="940"
        Height="850"
        MinWidth="940"
        MinHeight="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
        <shell:WindowChrome.WindowChrome>
            <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            CornerRadius="2"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBrush}">
        <Ellipse Width="760"
                 Height="500"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,-180,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#268B0000" />
                    <GradientStop Offset="1" Color="#008B0000" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="740"
                 Height="420"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,-190"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#14D4AF37" />
                    <GradientStop Offset="1" Color="#00D4AF37" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Margin="0"
                Background="{StaticResource InvitationFrameBrush}"
                Padding="1"
                Effect="{x:Null}">
            <Border Background="{StaticResource InvitationBrush}" Padding="18,14,18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="178" />
                    </Grid.RowDefinitions>

                    <!-- Invitation header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Library of Ruina"
                                       Foreground="{StaticResource GoldLightBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       FontStyle="Italic">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#D4AF37" Opacity="0.42" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource InvitationSubtitle}"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontSize="10.5"
                                       Margin="12,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Width="28"
                                Height="28"
                                    Content="—"
                                    Style="{StaticResource CaptionButtonStyle}"
                                    AutomationProperties.Name="Minimize"
                                    Click="MinimizeButton_Click" />
                        <Button Width="28"
                                Height="28"
                                    Content="✕"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource CloseCaptionButtonStyle}"
                                    AutomationProperties.Name="Close"
                                    Click="CloseButton_Click" />
                        </StackPanel>

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Main body -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Side rail -->
                        <Border Grid.Column="0"
                                Background="{StaticResource RailBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="13" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Width="100"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource GoldDimBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="SteamAvatarImage"
                                               Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom"
                                                Background="#D90A0A0C"
                                                BorderBrush="#4DD4AF37"
                                                BorderThickness="0,1,0,0"
                                                Padding="5,4">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Ellipse x:Name="SteamStatusDot"
                                                             Width="7"
                                                             Height="7"
                                                             Fill="{StaticResource DangerBrush}"
                                                             Margin="0,0,6,0" />
                                                    <TextBlock x:Name="SteamStatusText"
                                                               Text="{DynamicResource Disconnected}"
                                                               Foreground="{StaticResource GoldLightBrush}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               MaxWidth="76"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button x:Name="ReconnectButton"
                                                 Content="{DynamicResource Reconnect}"
                                                 Style="{StaticResource SecondaryButtonStyle}"
                                                        MinHeight="24"
                                                        Padding="6,1"
                                                        FontSize="11"
                                                        Margin="0,3,0,0"
                                                        Click="ReconnectButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{DynamicResource ModeHeading}" Style="{StaticResource RailHeadingStyle}" />
                                    <Button x:Name="CreateModeButton"
                                            AutomationProperties.AutomationId="CreateModeButton"
                                            Style="{StaticResource SelectedModeButtonStyle}"
                                            Click="CreateModeButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◇" Margin="0,0,7,0" />
                                            <TextBlock Text="{DynamicResource ContractCreate}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UpdateModeButton"
                                            AutomationProperties.AutomationId="UpdateModeButton"
                                            Style="{StaticResource ModeButtonStyle}"
                                            Margin="0,3,0,0"
                                            Click="UpdateModeButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◆" Margin="0,0,7,0" />
                                            <TextBlock Text="{DynamicResource ContractUpdate}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="4">
                                    <TextBlock Text="{DynamicResource VisibilityHeading}" Style="{StaticResource RailHeadingStyle}" />
                                    <Button x:Name="VisibilityPublicButton"
                                            Content="{DynamicResource VisibilityPublic}"
                                            Style="{StaticResource RailOptionButtonStyle}"
                                            Click="VisibilityPublicButton_Click" />
                                    <Button x:Name="VisibilityFriendsButton"
                                            Content="{DynamicResource VisibilityFriends}"
                                            Style="{StaticResource RailOptionButtonStyle}"
                                            Margin="0,3,0,0"
                                            Click="VisibilityFriendsButton_Click" />
                                    <Button x:Name="VisibilityPrivateButton"
                                            Content="{DynamicResource VisibilityPrivate}"
                                            Style="{StaticResource RailOptionSelectedButtonStyle}"
                                            Margin="0,3,0,0"
                                            Click="VisibilityPrivateButton_Click" />
                                </StackPanel>

                                <StackPanel Grid.Row="6">
                                    <TextBlock Text="{DynamicResource LanguageHeading}" Style="{StaticResource RailHeadingStyle}" />
                                    <Button x:Name="LanguageZhButton"
                                            Style="{StaticResource RailOptionSelectedButtonStyle}"
                                            Click="LanguageZhButton_Click">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="CN"
                                                       Foreground="{StaticResource TextGoldBrush}"
                                                    FontSize="11" />
                                            <TextBlock Text="简体中文" />
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="LanguageEnButton"
                                            Style="{StaticResource RailOptionButtonStyle}"
                                            Margin="0,3,0,0"
                                            Click="LanguageEnButton_Click">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="EN"
                                                       Foreground="{StaticResource TextGoldBrush}"
                                                    FontSize="11" />
                                            <TextBlock Text="English" />
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="LanguageJaButton"
                                            AutomationProperties.AutomationId="LanguageJaButton"
                                            Style="{StaticResource RailOptionButtonStyle}"
                                            Margin="0,3,0,0"
                                            Click="LanguageJaButton_Click">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="JP"
                                                       Foreground="{StaticResource TextGoldBrush}"
                                                    FontSize="11" />
                                            <TextBlock Text="日本語" />
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="LanguageKoButton"
                                            Style="{StaticResource RailOptionButtonStyle}"
                                            Margin="0,3,0,0"
                                            Click="LanguageKoButton_Click">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="KR"
                                                       Foreground="{StaticResource TextGoldBrush}"
                                                    FontSize="11" />
                                            <TextBlock Text="한국어" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main invitation form -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="162" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource InvitationCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource ContractSection}" Style="{StaticResource CardHeadingStyle}" />
                                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource GoldRuleBrush}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource FolderLabel}" Style="{StaticResource FieldLabelStyle}" />
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox x:Name="FolderPathTextBox"
                                                         Style="{StaticResource SingleLineTextBoxStyle}"
                                                         AllowDrop="True"
                                                         TextChanged="FolderPathTextBox_TextChanged"
                                                         GotKeyboardFocus="FolderPathTextBox_GotKeyboardFocus"
                                                         PreviewKeyDown="FolderPathTextBox_PreviewKeyDown"
                                                         LostKeyboardFocus="FolderPathTextBox_LostKeyboardFocus"
                                                         PreviewDragEnter="FolderPathTextBox_PreviewDragEnter"
                                                         PreviewDragOver="FolderPathTextBox_PreviewDragOver"
                                                         PreviewDragLeave="FolderPathTextBox_PreviewDragLeave"
                                                         PreviewDrop="FolderPathTextBox_PreviewDrop" />
                                                <TextBlock x:Name="FolderHintText"
                                                           Text="{DynamicResource FolderHint}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           Margin="9,0" />
                                                <Border x:Name="FolderDropOverlay"
                                                        Panel.ZIndex="2"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"
                                                        Background="#E61A160A"
                                                        BorderBrush="{StaticResource GoldBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                    <TextBlock Text="{DynamicResource FolderDropHint}"
                                                               Foreground="{StaticResource GoldLightBrush}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Button x:Name="BrowseButton"
                                                    Grid.Column="2"
                                                Height="36"
                                                    Content="{DynamicResource Browse}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="BrowseButton_Click" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="WorkshopIdLabelText"
                                                   Text="{DynamicResource WorkshopIdLabelUpdate}"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox x:Name="WorkshopIdTextBox"
                                                         Style="{StaticResource SingleLineTextBoxStyle}"
                                                         ToolTip="{DynamicResource WorkshopIdHint}"
                                                         TextChanged="WorkshopIdTextBox_TextChanged"
                                                         GotKeyboardFocus="WorkshopIdTextBox_GotKeyboardFocus"
                                                         LostKeyboardFocus="WorkshopIdTextBox_LostKeyboardFocus" />
                                                <TextBlock x:Name="WorkshopHintText"
                                                           Text="{DynamicResource WorkshopInputHint}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           Margin="9,0" />
                                            </Grid>
                                            <Button x:Name="WorkshopActionButton"
                                                    Grid.Column="2"
                                                    Height="36"
                                                    MinWidth="104"
                                                    Content="{DynamicResource FetchWorkshopInfo}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="WorkshopActionButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource InvitationCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource IdentitySection}" Style="{StaticResource CardHeadingStyle}" />
                                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource GoldRuleBrush}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="132" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="DropZoneBorder"
                                                    Grid.Column="0"
                                                    Background="{StaticResource InputBrush}"
                                                    BorderBrush="{StaticResource BorderBrightBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Width="132"
                                                    Height="132"
                                                    ClipToBounds="True"
                                                    Cursor="Hand"
                                                    AllowDrop="True"
                                                    MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                                                    DragEnter="DropZone_DragEnter"
                                                    Drop="DropZone_Drop">
                                                <Grid>
                                                    <Image x:Name="PreviewImage" Margin="1" Stretch="UniformToFill" />
                                                    <StackPanel x:Name="PreviewPlaceholderText"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="❖"
                                                                   Foreground="{StaticResource TextGoldBrush}"
                                                                   FontSize="18"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource PreviewMissing}"
                                                                   Foreground="{StaticResource TextGoldBrush}"
                                                                   FontSize="10.5"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   Margin="4,2" />
                                                    </StackPanel>
                                                    <Rectangle Margin="1"
                                                               Stroke="{StaticResource BorderBrightBrush}"
                                                               StrokeDashArray="3,2"
                                                               StrokeThickness="1"
                                                               IsHitTestVisible="False" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="56" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="56" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="20" />
                                                        <RowDefinition Height="36" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{DynamicResource TitleLabel}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="TitleTextBox" Grid.Row="1" Style="{StaticResource SingleLineTextBoxStyle}" />
                                                </Grid>
                                                <Grid Grid.Row="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="20" />
                                                        <RowDefinition Height="36" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{DynamicResource TagsLabel}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="TagsTextBox"
                                                             Grid.Row="1"
                                                             Style="{StaticResource SingleLineTextBoxStyle}"
                                                             ToolTip="{DynamicResource TagsHint}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="52" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{DynamicResource DescriptionLabel}"
                                                       Foreground="{StaticResource GoldLightBrush}"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="DescriptionTextBox"
                                                     Grid.Row="1"
                                                     MinHeight="70"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Hidden" />
                                            <TextBlock Grid.Row="3"
                                                       Text="{DynamicResource ChangeLogLabel}"
                                                       Foreground="{StaticResource GoldLightBrush}"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="ChangeLogTextBox"
                                                     Grid.Row="4"
                                                     Height="52"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Hidden" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Footer: real state, logs and final action -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="124" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#66000000"
                                BorderBrush="#26D4AF37"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="10,7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock x:Name="ValidationText"
                                               Text="{DynamicResource Ready}"
                                               Foreground="{StaticResource GoldLightBrush}"
                                               FontSize="9.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProgressText"
                                               Text="0%"
                                               Foreground="{StaticResource GoldBrush}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProgressStart" Text="{DynamicResource ProgressTransfer}" Style="{StaticResource ProgressStepInactiveStyle}" />
                                    <UniformGrid x:Name="ProgressSegmentsPanel" Grid.Column="1" Columns="24" Margin="8,0" />
                                    <TextBlock x:Name="ProgressComplete" Grid.Column="2" Text="{DynamicResource ProgressComplete}" Style="{StaticResource ProgressStepInactiveStyle}" />
                                </Grid>

                                <Rectangle Grid.Row="2"
                                           Fill="{StaticResource GoldRuleBrush}"
                                           Opacity="0.55" />

                                <TextBox x:Name="LogTextBox"
                                         Grid.Row="3"
                                         MinHeight="0"
                                         Margin="0,5,0,0"
                                         Padding="4,2"
                                         Background="#99050507"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="10.5"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>

                        <Button x:Name="ActionButton"
                                Grid.Row="2"
                                Content="{DynamicResource SignAndUpload}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ActionButton_Click" />
                    </Grid>

                </Grid>
            </Border>
        </Border>

        <!-- HTML corner decorations are positioned against the invitation window itself. -->
        <Border Panel.ZIndex="10" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                BorderBrush="{StaticResource GoldBrush}" BorderThickness="1,1,0,0" Opacity="0.8" IsHitTestVisible="False" />
        <Border Panel.ZIndex="10" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,1,1,0" Opacity="0.8" IsHitTestVisible="False" />
        <Border Panel.ZIndex="10" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                BorderBrush="{StaticResource GoldBrush}" BorderThickness="1,0,0,1" Opacity="0.8" IsHitTestVisible="False" />
        <Border Panel.ZIndex="10" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,1,1" Opacity="0.8" IsHitTestVisible="False" />
    </Grid>
</Window>
